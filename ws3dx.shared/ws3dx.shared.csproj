<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ws3dx.shared.snk</AssemblyOriginatorKeyFile>
    <PackageLicenseFile>MITlicense.txt</PackageLicenseFile>
    <PackageId>ws3dx.shared</PackageId>
    <Description>Base logic and data module</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Product>3DEXPERIENCE Web Services Client SDK for Dotnet Core</Product>
    <RepositoryUrl>https://github.com/3ds-cpe-emed/ws3dx-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyName>ws3dx.shared</AssemblyName>
    <Version>426.3.2</Version>
    <PackageTags>3DEXPERIENCE</PackageTags>
    <PackageReleaseNotes>added json property names to GenericResponse</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="MITlicense.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="data.extension\" />
  </ItemGroup>

</Project>
